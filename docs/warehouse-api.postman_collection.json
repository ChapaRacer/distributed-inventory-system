{
    "info": {
        "name": "Distributed Inventory System",
        "description": "API collection for testing all endpoints via the API Gateway on port 8080.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8080"
        }
    ],
    "item": [
        {
            "name": "Products",
            "item": [
                {
                    "name": "Get All Products",
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/api/products"
                    }
                },
                {
                    "name": "Get Product by ID",
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/api/products/1"
                    }
                },
                {
                    "name": "Create Product",
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/api/products",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                        "raw": "{\n \"sku\": \"MONITOR-27-4K\",\n \"name\": \"27 inch 4K Monitor\",\n \"description\": \"IPS panel, USB-C, 144Hz\",\n \"unitPrice\": 8500.00,\n \"category\": \"Electronic\",\n \"initialStock\": 25\n}"
                        }
                    }
                },
                {
                    "name": "Update Stock",
                    "request": {
                        "method": "PUT",
                        "url": "{{baseUrl}}/api/products/1/stock",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n \"warehouseId\": 1,\n \"quantityDelta\": 50,\n \"reason\": \"STOCK_RECEIVE\"\n}"
                        }
                    }
                },
                {
                    "name": "Get Low Stock Products",
                    "request": {
                        "methods": "GET",
                        "url": "{{baseUrl}}/api/products/low-stock"
                    }
                },
                {
                    "name": "Search Products by Name",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/products/search?name=laptop",
                            "query": [{ "key": "name", "value": "laptop"}]
                        }
                    }
                },
                {
                    "name": "Delete Product",
                    "request": {
                        "method": "DELETE",
                        "url": "{{baseUrl}}/api/products/5"
                    }
                }
            ]
        },
        {
            "name": "Orders",
            "item": [
                {
                    "name": "Get All Orders",
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/api/orders"
                    }
                },
                {
                    "name": "Place Order",
                    "request": {
                        "method": "POST",
                        "url": "{{baseUrl}}/api/orders",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"productSku\": \"LAPTOP-PRO-16\",\n      \"productName\": \"Laptop Pro 16 inch\",\n      \"quantity\": 2,\n      \"unitPrice\": 25000.00\n    }\n  ],\n  \"notes\": \"Priority shipping\"\n}"
                        }
                    }
                },
                {
                    "name": "Get Order by ID",
                    "request": {
                        "method": "GET",
                        "url": "{{baseUrl}}/api/orders/1"
                    }
                },
                {
                    "name": "Cancel Order",
                    "request": {
                        "method": "PUT",
                        "url": "{{baseUrl}}/api/orders/1/cancel"
                    }
                }
            ]
        }
    ]
}